{
  "RemoteService": {
    "Host": "",
    "Port": 9443,
    "TlsHostName": "",
    "ConnectTimeoutSeconds": 30,
    "ClientCertificate": {
      "Thumbprint": "",
      "StoreName": "My",
      "StoreLocation": "CurrentUser"
    },
    "Reconnect": {
      "InitialDelaySeconds": 2,
      "MaxDelaySeconds": 30,
      "BackoffMultiplier": 2.0,
      "JitterFactor": 0.2
    },
    "Buffer": {
      "MaximumQueuedBytes": 4194304
    }
  },
  "Logging": {
    "File": {
      "Directory": "",
      "FileNamePrefix": "techconnect.client",
      "RetainedFileCountLimit": 14,
      "FileSizeLimitBytes": 10485760
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  }
}
