{
  "RemoteService": {
    "Host": "127.0.0.1",
    "Port": 9443,
    "TlsHostName": "localhost",
    "ClientCertificate": {
      "Thumbprint": "<run tools/TechConnect.Client.DevCerts provision>",
      "StoreName": "My",
      "StoreLocation": "CurrentUser",
      "ExpectedSubject": "CN=TechConnector Development Client",
      "ExpectedIssuer": "CN=TechConnector Development CA"
    },
    "Reconnect": {
      "InitialDelaySeconds": 2,
      "MaxDelaySeconds": 60,
      "BackoffMultiplier": 2.0,
      "JitterFactor": 0.2
    },
    "Buffer": {
      "MaximumQueuedBytes": 4194304
    }
  },
  "DevelopmentCertificates": {
    "CaThumbprint": "<provisioned>",
    "ServerThumbprint": "<provisioned>",
    "ClientThumbprint": "<provisioned>",
    "CaSubject": "CN=TechConnector Development CA",
    "ServerSubject": "CN=TechConnector Development WSS",
    "ClientSubject": "CN=TechConnector Development Client"
  },
  "Logging": {
    "File": {
      "Directory": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "TechConnect.Client": "Debug"
      }
    }
  }
}
