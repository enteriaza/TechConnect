<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>TechConnect.Protocol</RootNamespace>
    <AssemblyName>TechConnect.Protocol</AssemblyName>
    <Description>TechConnect binary framing protocol and control-message DTOs shared by TechConnect.Client and TechConnect.Server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechConnect.Protocol.Tests" />
  </ItemGroup>

</Project>
